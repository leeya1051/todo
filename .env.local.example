# MongoDB Atlas connection string used by lib/db.ts to connect via Mongoose
MONGODB_URI=
# Random secret used by NextAuth.js to sign/encrypt JWTs and session cookies
NEXTAUTH_SECRET=
# Base URL of the app, used by NextAuth.js for callback URLs
NEXTAUTH_URL=http://localhost:3000
# GitHub OAuth App credentials, see docs/GITHUB_OAUTH_SETUP.md
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
